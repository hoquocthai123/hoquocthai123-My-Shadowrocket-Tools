#!name=Locket & YouTube Premium Fix
#!desc=Mở khóa Locket Gold (Fix 5s) và Chặn quảng cáo YouTube.
#!author=Thái_Ho_Shadowrocket

[Script]
# Locket Gold - Sử dụng script của RuCu6 để ổn định nhất
locket_gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/RuCu6/QuanX/main/Scripts/locket.js, requires-body=true, timeout=60

# YouTube Adblock - Chặn quảng cáo và phát nhạc nền
youtube_premium = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player), script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, youtubei.googleapis.com, *.googlevideo.com