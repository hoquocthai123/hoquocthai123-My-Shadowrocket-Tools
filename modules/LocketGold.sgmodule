#!name=Locket Gold Ultra Fix
#!desc=Mở khóa Gold & Quay video dài (Fix 5s)

[Script]
# Fix quyền hạn trong Config (Lưu ý thay link github của Thái vào đây)
locket_config = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/v2\/config, script-path=https://raw.githubusercontent.com/hoquocthai123/hoquocthai123-My-Shadowrocket-Tools/main/js/locket_fix.js, requires-body=true, timeout=60

# Fix thông tin mua hàng RevenueCat
locket_revenue = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/RuCu6/QuanX/main/Scripts/locket.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.locketcamera.com, api.revenuecat.com