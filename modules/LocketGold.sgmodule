#!name=Locket Gold Ultra Fix
#!desc=Unlock Premium & Fix lỗi quay phim 5s (Dữ liệu Charles).

[Script]
# Sử dụng script locket_fix.js do chính bạn quản lý trên GitHub
locket_premium = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/hoquocthai123/hoquocthai123-My-Shadowrocket-Tools/main/js/locket_fix.js, requires-body=true, timeout=60

# Thêm script xử lý config của Locket camera để fix lỗi quay 5s
locket_config = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/v1\/users\/me, script-path=https://raw.githubusercontent.com/hoquocthai123/hoquocthai123-My-Shadowrocket-Tools/main/js/locket_fix.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.locketcamera.com