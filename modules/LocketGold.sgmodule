#!name=Locket Gold Ultra Fix
#!desc=Mở khóa Locket Gold và Fix lỗi quay phim 5s (Cập nhật 2026).
#!author=Thái_Ho_Shadowrocket

[Script]
# Sử dụng 1 script duy nhất cho cả 2 hệ thống kiểm tra của Locket
locket_all = type=http-response, pattern=^https:\/\/api\.(revenuecat\.com|locketcamera\.com)\/.+, script-path=https://raw.githubusercontent.com/hoquocthai123/hoquocthai123-My-Shadowrocket-Tools/main/js/locket_fix.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.locketcamera.com, youtubei.googleapis.com, *.googlevideo.com