#!name=Locket Gold Ultra Fix 2026
#!desc=Mở khóa Locket Gold & Fix lỗi quay phim 5s (DuyVinh09 + Charles Fix).
#!author=Thái_Ho_Shadowrocket

[Script]
# Xử lý gộp cả hiện logo Gold và tính năng quay phim dài
locket_all = type=http-response, pattern=^https:\/\/api\.(revenuecat\.com|locketcamera\.com)\/.+, script-path=https://raw.githubusercontent.com/hoquocthai123/hoquocthai123-My-Shadowrocket-Tools/main/js/locket_fix.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.locketcamera.com