#!name=Locket Gold Ultra
#!desc=Mở khóa tính năng Premium & Fix lỗi quay phim.

[Script]
# Fix Locket Gold bằng cách can thiệp vào RevenueCat
locket_premium = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/hoquocthai123/My-Shadowrocket-Tools/main/js/locket_fix.js, requires-body=true, timeout=60

# Xóa Header để tránh bị App phát hiện máy ảo/hack
del_header = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/hoquocthai123/My-Shadowrocket-Tools/main/js/deleteHeader.js

[MITM]
hostname = %APPEND% api.revenuecat.com
